# --- LLM (hosted Gemini API, no local inference) ---
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Render (and most managed Postgres providers) hand out `postgres://` URLs —
# app/config/settings.py normalizes that scheme to `postgresql://`
# automatically, so either form works here.
DATABASE_URL=postgresql+psycopg2://cloudpilot:cloudpilot@postgres:5432/cloudpilot

# --- CORS ---
# Comma-separated list of exact production origins allowed to call the API
# (e.g. your Vercel production URL). Leave empty for local dev — localhost
# origins are always allowed, and any https://*.vercel.app preview URL is
# allowed automatically via a regex in app/main.py, independent of this list.
ALLOWED_ORIGINS=

# --- Currency (display only — see app/services/currency.py) ---
# All persisted/computed monetary values are USD, always. This rate is used
# solely to reformat already-computed USD figures for display (frontend
# USD/INR toggle); it is never an input to any forecast, pricing, or
# optimization calculation.
USD_TO_INR_RATE=83.0
